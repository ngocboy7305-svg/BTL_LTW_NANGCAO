 @model IEnumerable<BTL_QLTuyenSinh.Models.DiemThi>

@{
    ViewData["Title"] = "Quản lý điểm thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string tuKhoa = ViewBag.TuKhoa ?? "";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">QUẢN LÝ ĐIỂM THI</h4>
            <p class="text-muted small mb-0">Tra cứu và cập nhật điểm thi của thí sinh</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm px-3 fw-semibold">
            + Nhập điểm
        </a>
    </div>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 p-3 mb-4">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-9">
                <input name="tuKhoa"
                       value="@tuKhoa"
                       class="form-control form-control-sm"
                       placeholder="Tìm theo mã hồ sơ, mã môn hoặc tên môn..." />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    Tìm kiếm
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    Làm mới
                </a>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-3 py-3">Mã điểm</th>
                        <th>Mã hồ sơ</th>
                        <th>Mã môn</th>
                        <th>Tên môn</th>
                        <th>Điểm số</th>
                        <th>Ngày cập nhật</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-3">@item.MaDiemId</td>
                                <td>@item.HoSo?.MaHoSo</td>
                                <td>@item.MonThi?.MaMon</td>
                                <td>@item.MonThi?.TenMon</td>
                                <td>
                                    <span class="badge bg-primary rounded-pill">
                                        @item.DiemSo.ToString("0.00")
                                    </span>
                                </td>
                                <td>@item.NgayCapNhat.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.MaDiemId"
                                       class="btn btn-sm btn-outline-warning">
                                        Sửa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <div class="fw-semibold mb-1">Chưa có dữ liệu điểm thi</div>
                                <small>Danh sách sẽ hiển thị sau khi có điểm thi được lưu.</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>