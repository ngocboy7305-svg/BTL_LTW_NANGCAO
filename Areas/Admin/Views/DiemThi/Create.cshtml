@model BTL_QLTuyenSinh.Models.DiemThi

@{
    ViewData["Title"] = "Nhập điểm thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Nhập điểm thi</h4>
        </div>

        <div class="card-body">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="MaHoSoId" class="form-label">
                        Hồ sơ tuyển sinh
                    </label>
                    <select asp-for="MaHoSoId"
                            asp-items="ViewBag.DanhSachHoSo"
                            class="form-select">
                        <option value="">-- Chọn hồ sơ --</option>
                    </select>
                    <span asp-validation-for="MaHoSoId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaMonId" class="form-label">
                        Môn thi
                    </label>
                    <select asp-for="MaMonId"
                            asp-items="ViewBag.DanhSachMon"
                            class="form-select">
                        <option value="">-- Chọn môn thi --</option>
                    </select>
                    <span asp-validation-for="MaMonId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiemSo" class="form-label">
                        Điểm số (0–10)
                    </label>
                    <input asp-for="DiemSo"
                           type="number"
                           min="0"
                           max="10"
                           step="0.01"
                           class="form-control" />
                    <span asp-validation-for="DiemSo"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Lưu điểm
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
