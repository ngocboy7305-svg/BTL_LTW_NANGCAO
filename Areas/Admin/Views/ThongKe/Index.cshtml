@{
    ViewData["Title"] = "Thống kê & Báo cáo Tuyển sinh (FR-14 & FR-15)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var danhSachKhoa = ViewBag.DanhSachKhoa as List<string> ?? new List<string>();
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="fw-bold text-dark mb-1">THỐNG KÊ &amp; BÁO CÁO TUYỂN SINH TRỰC TUYẾN (FR-14, FR-15)</h4>
            <p class="text-muted small mb-0">Tổng hợp KPI hồ sơ, tỷ lệ chọi từng ngành và xuất báo cáo CSV</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Admin/ThongKe/ExportCsv" class="btn btn-success btn-sm px-3 fw-semibold">
                ⬇ Xuất Báo cáo CSV (FR-15)
            </a>
            <button type="button" class="btn btn-primary btn-sm px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#modalCreateBaoCao">
                + Chốt số liệu báo cáo ($.ajax)
            </button>
        </div>
    </div>

    <div id="thongKeAlertBox" class="alert d-none py-2 small shadow-sm" role="alert"></div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="text-muted small fw-semibold">TỔNG SỐ HỒ SƠ NỘP</div>
                <div class="fs-4 fw-bold text-primary mt-1" id="kpiTongHoSo">0</div>
                <div class="small text-secondary mt-1">
                    Hợp lệ: <strong class="text-success" id="kpiHoSoHopLe">0</strong> | Chờ: <strong class="text-warning" id="kpiHoSoChoDuyet">0</strong>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="text-muted small fw-semibold">TỔNG NGUYỆN VỌNG</div>
                <div class="fs-4 fw-bold text-dark mt-1" id="kpiTongNguyenVong">0</div>
                <div class="small text-secondary mt-1">Thí sinh: <strong id="kpiTongThiSinh">0</strong></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="text-muted small fw-semibold">TỔNG SỐ TRÚNG TUYỂN</div>
                <div class="fs-4 fw-bold text-success mt-1" id="kpiTongTrungTuyen">0</div>
                <div class="small text-secondary mt-1">Không hợp lệ: <strong class="text-danger" id="kpiHoSoKhongHopLe">0</strong></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="text-muted small fw-semibold">THÔNG BÁO ĐÃ GỬI</div>
                <div class="fs-4 fw-bold text-info mt-1" id="kpiTongThongBao">0</div>
                <div class="small text-secondary mt-1">Cập nhật qua AJAX</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-3 mb-4 rounded-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-secondary mb-1">Tìm kiếm ngành (Fetch API):</label>
                <input type="text" id="txtSearchThongKe" class="form-control form-control-sm" placeholder="Nhập mã ngành hoặc tên ngành..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Lọc theo Khoa:</label>
                <select id="selKhoaThongKe" class="form-select form-select-sm">
                    <option value="">-- Tất cả các Khoa --</option>
                    @foreach (var k in danhSachKhoa)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Sắp xếp:</label>
                <select id="selSortThongKe" class="form-select form-select-sm">
                    <option value="ma_asc">Mã ngành (A-Z)</option>
                    <option value="nv_desc">Nhiều nguyện vọng nhất</option>
                    <option value="chitieu_desc">Chỉ tiêu cao nhất</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Số dòng/trang:</label>
                <select id="selPageSizeThongKe" class="form-select form-select-sm">
                    <option value="5" selected>5 ngành/trang</option>
                    <option value="10">10 ngành/trang</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="card-header bg-white py-2 px-3 border-bottom">
            <span class="fw-bold small text-dark">BẢNG BÁO CÁO TỶ LỆ CHỌI &amp; KẾT QUẢ THEO NGÀNH (FR-14, FR-15)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-secondary">
                    <tr>
                        <th class="ps-3">Mã ngành</th>
                        <th>Tên ngành đào tạo</th>
                        <th>Khoa</th>
                        <th class="text-center">Chỉ tiêu</th>
                        <th class="text-center">Tổng NV</th>
                        <th class="text-center">Số NV1</th>
                        <th class="text-center">Tỷ lệ chọi</th>
                        <th class="text-center">Điểm sàn / Chuẩn</th>
                        <th class="text-center pe-3">Trúng tuyển</th>
                    </tr>
                </thead>
                <tbody id="thongKeTableBody">
                    <tr><td colspan="9" class="text-center py-4 text-muted">Đang tải báo cáo bằng XMLHttpRequest...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top py-3 px-3 d-flex flex-wrap justify-content-between align-items-center">
            <div id="thongKePagingInfo" class="small text-muted">Đang tải phân trang...</div>
            <nav><ul id="thongKePagination" class="pagination pagination-sm mb-0"></ul></nav>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-2 px-3 border-bottom">
            <span class="fw-bold small text-dark">BIÊN BẢN CHỐT BÁO CÁO TUYỂN SINH (CRUD jQuery $.ajax)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th class="ps-3">Mã biên bản</th>
                        <th>Loại báo cáo</th>
                        <th>Nội dung tổng hợp</th>
                        <th>Người lập</th>
                        <th>Thời gian</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="baoCaoLogBody">
                    <tr><td colspan="6" class="text-center py-3 text-muted small">Đang tải nhật ký báo cáo...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCreateBaoCao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="formCreateBaoCaoAjax">
                <div class="modal-header bg-primary text-white">
                    <h6 class="modal-title fw-bold">LẬP BIÊN BẢN CHỐT SỐ LIỆU (jQuery $.ajax)</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên / Loại báo cáo <span class="text-danger">*</span></label>
                        <input type="text" id="inpLoaiBaoCao" class="form-control form-control-sm" value="Báo cáo thống kê tuyển sinh đợt 1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Người lập</label>
                        <input type="text" id="inpNguoiLapBaoCao" class="form-control form-control-sm" value="Đào Việt Đức" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Nội dung nhận xét / tổng hợp <span class="text-danger">*</span></label>
                        <textarea id="inpNoiDungBaoCao" class="form-control form-control-sm" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold">Lưu biên bản ($.ajax)</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/thongke-ajax.js" asp-append-version="true"></script>
}