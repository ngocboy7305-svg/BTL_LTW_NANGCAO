@model IEnumerable<BTL_QLTuyenSinh.Models.NganhHoc>

@{
    ViewData["Title"] = "Quản lý Ngành tuyển sinh";
}

<h2 class="mt-3 mb-3 text-primary">Danh mục Ngành đào tạo tuyển sinh</h2>

<p>
    <a asp-action="Create" class="btn btn-success">+ Thêm ngành mới</a>
</p>

<!-- Form Tìm kiếm -->
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm theo mã hoặc tên ngành..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-secondary">Đặt lại</a>
    </div>
</form>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Mã ngành</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="text-white text-decoration-none">
                    Tên ngành ⬍
                </a>
            </th>
            <th>Khoa</th>
            <th>Chỉ tiêu</th>
            <th>Tổ hợp</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["ScoreSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="text-white text-decoration-none">
                    Điểm sàn ⬍
                </a>
            </th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaNganh</td>
                <td>@item.TenNganh</td>
                <td>@item.TenKhoa</td>
                <td>@item.ChiTieu</td>
                <td>@item.ToHopXetTuyen</td>
                <td>@item.DiemSan</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MaNganhId" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.MaNganhId" class="btn btn-sm btn-info">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.MaNganhId" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Thanh Phân trang -->
<nav>
    <ul class="pagination">
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@i"
                   asp-route-sortOrder="@ViewData["CurrentSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]">@i</a>
            </li>
        }
    </ul>
</nav>