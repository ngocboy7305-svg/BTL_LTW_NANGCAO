@model BTL_QLTuyenSinh.Models.HoSoTuyenSinh
@{
    ViewData["Title"] = "Tra cứu kết quả xét tuyển";
    var danhSachDiem = ViewBag.DanhSachDiem as List<BTL_QLTuyenSinh.Models.DiemThi>;
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-bold text-uppercase">
                <i class="bi bi-mortarboard-fill me-2"></i>KẾT QUẢ XÉT TUYỂN TUYỂN SINH NĂM @(Model?.NamTuyenSinh ?? DateTime.Now.Year)
            </h5>
        </div>
        <div class="card-body p-4">
            @if (Model == null)
            {
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-info-circle me-2"></i>Hiện tại bạn chưa nộp hồ sơ đăng ký xét tuyển nào trên hệ thống.
                </div>
            }
            else
            {
                <!-- THÔNG TIN HỒ SƠ & ĐIỂM THI -->
                <div class="row g-3 mb-4 bg-light p-3 rounded">
                    <div class="col-md-4">
                        <div class="text-muted small">Mã hồ sơ:</div>
                        <div class="fw-bold text-primary">@Model.MaHoSo</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Trạng thái hồ sơ:</div>
                        <div>
                            <span class="badge @(Model.TrangThaiHoSo == "Hợp lệ" || Model.TrangThaiHoSo == "Đã duyệt" ? "bg-success" : "bg-warning text-dark")">
                                @Model.TrangThaiHoSo
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Ưu tiên (Khu vực / Đối tượng):</div>
                        <div class="fw-semibold">@Model.KhuVucUuTien / @Model.DoiTuongUuTien (Cộng: +@(Model.DiemCongUuTien.ToString("0.00"))đ)</div>
                    </div>

                    <!-- HIỂN THỊ ĐIỂM THI TỪNG MÔN -->
                    @if (danhSachDiem != null && danhSachDiem.Any())
                    {
                        <div class="col-12 border-top pt-2 mt-2">
                            <span class="text-muted small me-2"><strong>Điểm thi đã ghi nhận:</strong></span>
                            @foreach (var d in danhSachDiem)
                            {
                                <span class="badge bg-secondary me-2">
                                    @(d.MonThi?.TenMon ?? $"Môn {d.MaMonId}"): @d.DiemSo.ToString("0.00")
                                </span>
                            }
                        </div>
                    }
                </div>

                <!-- BẢNG CHI TIẾT NGUYỆN VỌNG -->
                <h6 class="fw-bold text-dark mb-3">CHI TIẾT ĐIỂM VÀ KẾT QUẢ TỪNG NGUYỆN VỌNG</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Thứ tự</th>
                                <th class="text-start">Ngành đào tạo</th>
                                <th style="width: 100px;">Tổ hợp</th>
                                <th style="width: 140px;">Điểm của bạn</th>
                                <th style="width: 140px;">Điểm chuẩn</th>
                                <th style="width: 160px;">Kết quả</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DanhSachNguyenVong != null && Model.DanhSachNguyenVong.Any())
                            {
                                @foreach (var nv in Model.DanhSachNguyenVong.OrderBy(x => x.ThuTuNguyenVong))
                                {
                                    <tr>
                                        <td class="fw-bold">NV @nv.ThuTuNguyenVong</td>
                                        <td class="text-start">
                                            <div class="fw-bold text-dark">@(nv.NganhHoc?.TenNganh ?? $"Mã ngành: {nv.MaNganhId}")</div>
                                            <small class="text-muted">Mã: @(nv.NganhHoc?.MaNganh)</small>
                                        </td>
                                        <td class="fw-semibold">@nv.KhoiXetTuyen</td>
                                        <td class="fw-bold text-primary fs-6">
                                            @(nv.TongDiemXetTuyen.HasValue && nv.TongDiemXetTuyen.Value > 0 ? nv.TongDiemXetTuyen.Value.ToString("0.00") : "Đang cập nhật")
                                        </td>
                                        <td class="fw-bold text-dark fs-6">
                                            @(nv.NganhHoc?.DiemChuan.HasValue == true ? nv.NganhHoc.DiemChuan.Value.ToString("0.00") : "Chưa công bố")
                                        </td>
                                        <td>
                                            @if (nv.KetQuaXetTuyen == "Trúng tuyển")
                                            {
                                                <span class="badge bg-success py-2 px-3">
                                                    <i class="bi bi-check-circle me-1"></i>Trúng tuyển
                                                </span>
                                            }
                                            else if (nv.KetQuaXetTuyen == "Không trúng tuyển")
                                            {
                                                <span class="badge bg-danger py-2 px-3">
                                                    <i class="bi bi-x-circle me-1"></i>Không trúng tuyển
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary py-2 px-3">
                                                    <i class="bi bi-hourglass-split me-1"></i>@nv.KetQuaXetTuyen
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-muted py-3">Không có thông tin nguyện vọng nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="small text-muted mt-3">
                    * <em>Ghi chú: Điểm của bạn đã bao gồm tổng điểm 3 môn theo tổ hợp và điểm ưu tiên khu vực / đối tượng (nếu có).</em>
                </div>
            }
        </div>
    </div>
</div>