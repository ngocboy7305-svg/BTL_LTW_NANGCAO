@model BTL_QLTuyenSinh.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản xét tuyển";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h3 class="fw-bold text-dark mb-1">ĐĂNG KÝ TÀI KHOẢN XÉT TUYỂN</h3>
                        <p class="text-muted small">Dành cho thí sinh tham gia xét tuyển trực tuyến năm 2026</p>
                    </div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="HoTen" class="form-label fw-semibold small">Họ và tên thí sinh (*)</label>
                                <input asp-for="HoTen" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CCCD" class="form-label fw-semibold small">Số CCCD / Mã định danh (*)</label>
                                <input asp-for="CCCD" class="form-control" placeholder="12 chữ số CCCD" maxlength="12" />
                                <span asp-validation-for="CCCD" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold small">Địa chỉ Email (*)</label>
                                <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label fw-semibold small">Số điện thoại (*)</label>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="0912xxxxxx" />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MatKhau" class="form-label fw-semibold small">Mật khẩu (*)</label>
                                <input asp-for="MatKhau" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                                <span asp-validation-for="MatKhau" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="XacNhanMatKhau" class="form-label fw-semibold small">Xác nhận mật khẩu (*)</label>
                                <input asp-for="XacNhanMatKhau" class="form-control" placeholder="Nhập lại mật khẩu" />
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="alert alert-primary mt-4 mb-3 py-2 small" role="alert">
                            📌 <strong>Lưu ý:</strong> Số CCCD sẽ dùng làm Tên đăng nhập mặc định và dùng đối soát kết quả trúng tuyển suốt kỳ thi.
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mt-2 shadow-sm">TẠO TÀI KHOẢN XÉT TUYỂN</button>

                        <div class="text-center mt-3 small text-muted">
                            Đã có tài khoản? <a asp-action="Login" class="text-decoration-none fw-bold text-primary">Đăng nhập ngay tại đây</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}